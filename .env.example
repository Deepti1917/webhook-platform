# Copy to .env and fill in real values:   cp .env.example .env
# Generate all the secrets in one go:      ./scripts/generate-secrets.sh
# .env is git-ignored. NEVER commit it, and never paste real values into this file.

# --- Database -------------------------------------------------------------
DB_NAME=webhooks
# Schema owner: used only by Flyway migrations.
DB_OWNER_USER=webhooks_owner
DB_OWNER_PASSWORD=CHANGE_ME
# Runtime user: limited to SELECT/INSERT/UPDATE/DELETE. The app uses this one for all requests.
APP_DB_USER=webhooks_app
APP_DB_PASSWORD=CHANGE_ME

# --- Application secrets --------------------------------------------------
# Admin API key (min 32 chars). Authenticates /admin/** and /actuator/** (except health).
ADMIN_API_KEY=CHANGE_ME
# Base64 of exactly 32 random bytes. Encrypts webhook signing secrets in the database.
# If you lose or change it, existing signing secrets become unreadable: back it up.
SECRET_ENCRYPTION_KEY=CHANGE_ME

# --- Optional ---------------------------------------------------------------
# Exact browser origins allowed to call /api/**, comma separated. Leave empty if only servers call the API.
CORS_ALLOWED_ORIGINS=
# Set to "native" only if you run behind a reverse proxy you control (so client IPs are read correctly).
FORWARD_HEADERS_STRATEGY=none
# DEV ONLY: allow webhook targets on localhost / private networks over plain http.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false
